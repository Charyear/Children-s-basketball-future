/* pages/parent/enroll/enroll.wxss */
page {
  background: linear-gradient(to bottom, #EFF6FF 0%, #FFF7ED 100%);
}

.enroll-container {
  width: 100%;
  min-height: 100vh;
}

/* 主内容区域 */
.main-content {
  padding: 0 30rpx;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

/* 状态筛选标签 */
.tab-bar {
  display: flex;
  flex-direction: row;
  gap: 32rpx;
  padding: 30rpx 30rpx;
  overflow-x: auto;
  white-space: nowrap;
}

.tab-bar::-webkit-scrollbar {
  display: none;
}

.tab-item {
  display: inline-block;
  padding: 8rpx 20rpx;
  border-radius: 50rpx;
  font-size: 24rpx;
  font-weight: 400;
  white-space: nowrap;
  background-color: #FFFFFF;
  color: #666666;
  flex-shrink: 0;
  transition: all 0.3s;
}

.tab-item.active {
  background-color: #FF7A2F;
  color: #FFFFFF;
  font-weight: 500;
}

/* 报名列表 */
.enroll-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.enroll-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
  border: 1rpx solid #F5F5F5;
}

.enroll-card-image {
  width: 100%;
  height: 240rpx;
  border-radius: 16rpx;
  object-fit: cover;
}

.enroll-card-content {
  padding-top: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.enroll-card-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.enroll-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.enroll-card-status {
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.enroll-card-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.enroll-card-meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #999999;
}

.enroll-card-meta-item text {
  font-size: 24rpx;
}

.enroll-card-footer {
  display: flex;
  gap: 20rpx;
  padding-top: 16rpx;
}

.enroll-card-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  line-height: 1;
}

.enroll-card-btn.primary {
  background-color: #EFF6FF;
  color: #3B82F6;
}

.enroll-card-btn.secondary {
  background-color: #FFF7ED;
  color: #FF7A2F;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  color: #E5E7EB;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 报名详情弹窗 */
.detail-modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0);
  z-index: 10000;
  display: none;
  align-items: flex-start;
  transition: background-color 0.3s;
}

.detail-modal-mask.show {
  display: flex;
  background-color: rgba(0, 0, 0, 0.5);
}

.detail-modal {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 85vh;
  max-height: 85vh;
  background-color: #FFFFFF;
  border-radius: 40rpx 40rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  display: flex;
  flex-direction: column;
  z-index: 10000;
}

.detail-modal.show {
  transform: translateY(0);
}

.detail-modal-content {
  flex: 1;
  height: 0;
}

.detail-event-image {
  width: 100%;
  height: 400rpx;
  object-fit: cover;
  flex-shrink: 0;
}

.detail-status-banner {
  padding: 20rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: 500;
}

.detail-event-info {
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  flex: 1;
}

.detail-event-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  line-height: 1.4;
}

.detail-meta-item {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F0F0F0;
}

.detail-meta-item:last-child {
  border-bottom: none;
}

.detail-meta-icon {
  font-size: 32rpx;
  flex-shrink: 0;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.detail-meta-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.detail-meta-label {
  font-size: 24rpx;
  color: #999999;
}

.detail-meta-value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.detail-footer {
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #F0F0F0;
  flex-shrink: 0;
}

.detail-enroll-btn {
  width: 100%;
  height: 88rpx;
  background-color: #FF7A2F;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  font-weight: 500;
  color: #FFFFFF;
}

.detail-close-btn {
  background-color: #3B82F6;
  color: #FFFFFF;
}
