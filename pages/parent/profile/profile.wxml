<!--pages/parent/profile/profile.wxml-->
<view class="profile-container">
  <!-- 用户信息区域 -->
  <view class="user-section">
    <view class="user-info">
      <view class="user-avatar">
        <image src="{{userInfo.avatar}}" mode="aspectFill"></image>
      </view>
      <view class="user-details">
        <text class="user-name">{{userInfo.name}}</text>
        <text class="user-id">账号ID: {{userInfo.id}}</text>
      </view>
    </view>
  </view>

  <!-- 主内容区域 -->
  <view class="main-content">
    <!-- 我的孩子模块 -->
    <view class="children-section">
      <view class="section-header">
        <view class="section-title">
          <text class="iconfont icon-child" style="color: #FF7A2F;"></text>
          <text>我的孩子</text>
        </view>
        <view class="add-child-btn" bindtap="onAddChild">
          <text class="iconfont icon-plus"></text>
          <text>添加孩子</text>
        </view>
      </view>
      <view class="child-item" wx:for="{{children}}" wx:key="id">
        <view class="child-avatar">
          <image src="{{item.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="child-info">
          <text class="child-name">{{item.name}}</text>
          <text class="child-meta">{{item.age}} · {{item.class}}</text>
        </view>
      </view>
    </view>

    <!-- 常用功能 -->
    <view class="menu-section">
      <view class="section-header">
        <view class="section-title">
          <text>常用功能</text>
        </view>
      </view>
      <view class="menu-item" wx:for="{{menuList}}" wx:key="name" bindtap="onMenuTap" data-name="{{item.name}}">
        <view class="menu-left">
          <view class="menu-icon" style="background-color: {{item.bgColor}};">
            <text class="iconfont {{item.icon}}" style="color: {{item.color}};"></text>
          </view>
          <text class="menu-name">{{item.name}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-badge" wx:if="{{item.badge > 0}}">{{item.badge}}</text>
          <text class="menu-arrow iconfont icon-right"></text>
        </view>
      </view>
    </view>

    <!-- 设置功能 -->
    <view class="menu-section">
      <view class="menu-item" wx:for="{{settingList}}" wx:key="name" bindtap="onSettingTap" data-name="{{item.name}}">
        <view class="menu-left">
          <view class="menu-icon" style="background-color: #F3F4F6;">
            <text class="iconfont {{item.icon}}" style="color: {{item.color}};"></text>
          </view>
          <text class="menu-name" style="color: {{item.name === '退出登录' ? '#EF4444' : '#333333'}};">{{item.name}}</text>
        </view>
        <view class="menu-right">
          <text class="menu-arrow iconfont icon-right"></text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加孩子弹窗 -->
  <view class="add-child-modal-mask {{showAddChildModal ? 'show' : ''}}" bindtap="onCloseAddChildModal" catchtouchmove="preventTouchMove">
    <view class="add-child-modal-content" catchtap="preventTouchMove">
      <view class="add-child-modal-header">
        <text class="add-child-modal-title">添加孩子信息</text>
        <view class="add-child-close-btn" bindtap="onCloseAddChildModal">
          <text>✕</text>
        </view>
      </view>

      <view class="add-child-form">
        <view class="add-child-form-group">
          <text class="add-child-label">孩子姓名</text>
          <input class="add-child-input" placeholder="请输入孩子姓名" value="{{childForm.name}}" bindinput="onChildFormInput" data-field="name" />
        </view>

        <view class="add-child-form-group">
          <text class="add-child-label">孩子年龄</text>
          <input class="add-child-input" type="number" placeholder="请输入孩子年龄" value="{{childForm.age}}" bindinput="onChildFormInput" data-field="age" />
        </view>

        <view class="add-child-form-group">
          <text class="add-child-label">性别</text>
          <view class="add-child-gender-group">
            <view class="add-child-gender-option {{childForm.gender === '男' ? 'active' : ''}}" bindtap="onSelectGender" data-gender="男">男</view>
            <view class="add-child-gender-option {{childForm.gender === '女' ? 'active' : ''}}" bindtap="onSelectGender" data-gender="女">女</view>
          </view>
        </view>

        <view class="add-child-form-group">
          <text class="add-child-label">幼儿园</text>
          <input class="add-child-input" placeholder="请输入幼儿园名称" value="{{childForm.kindergarten}}" bindinput="onChildFormInput" data-field="kindergarten" />
        </view>

        <view class="add-child-form-group">
          <text class="add-child-label">年级</text>
          <input class="add-child-input" placeholder="请输入年级" value="{{childForm.grade}}" bindinput="onChildFormInput" data-field="grade" />
        </view>
      </view>

      <view class="add-child-modal-footer">
        <view class="add-child-modal-btn cancel" bindtap="onCloseAddChildModal">取消</view>
        <view class="add-child-modal-btn confirm" bindtap="onConfirmAddChild">确认添加</view>
      </view>
    </view>
  </view>
</view>
