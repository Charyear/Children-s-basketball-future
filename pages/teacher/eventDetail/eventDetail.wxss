/* pages/teacher/eventDetail/eventDetail.wxss */
page {
  background: linear-gradient(to bottom, #EFF6FF 0%, #FFF7ED 100%);
}

.detail-container {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

/* 图片轮播区域 */
.image-section {
  height: 25vh;
  background: #F5F5F5;
}

.event-swiper {
  width: 100%;
  height: 100%;
}

.event-image {
  width: 100%;
  height: 100%;
}

/* 赛事信息 */
.info-section {
  background: #FFFFFF;
  margin: 30rpx;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.event-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  line-height: 1.4;
}

.info-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-item.description {
  align-items: flex-start;
}

.info-icon {
  font-size: 40rpx;
  flex-shrink: 0;
  line-height: 1;
}

.info-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #999999;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}

.description-text {
  line-height: 1.8;
}

/* 学生列表 */
.students-section {
  background: #FFFFFF;
  margin: 30rpx;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.section-count {
  font-size: 28rpx;
  color: #FF7A2F;
  font-weight: 500;
}

.student-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.student-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: #F8F9FA;
  border-radius: 16rpx;
}

.student-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 3rpx solid #FFFFFF;
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

.student-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.student-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #333333;
}

.student-meta {
  font-size: 24rpx;
  color: #999999;
}

.student-status {
  flex-shrink: 0;
}

.status-badge {
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
}

.status-badge.completed {
  background: #10B98115;
  color: #10B981;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
  gap: 20rpx;
}

.empty-icon {
  font-size: 100rpx;
  opacity: 0.3;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}

/* 操作按钮 */
.action-section {
  padding: 0 30rpx;
}

.edit-btn {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #60A5FA 100%);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 500;
  border-radius: 16rpx;
  border: none;
  box-shadow: 0 8rpx 16rpx rgba(59, 130, 246, 0.3);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
}

.edit-btn::after {
  border: none;
}
