<!--pages/teacher/eventDetail/eventDetail.wxml-->
<view class="detail-container">
  <!-- 图片轮播区域 -->
  <view class="image-section">
    <swiper class="event-swiper" indicator-dots="{{eventDetail.images.length > 1}}" autoplay="{{eventDetail.images.length > 1}}" interval="3000" duration="500" circular="true">
      <swiper-item wx:for="{{eventDetail.images}}" wx:key="index">
        <image src="{{item}}" mode="aspectFill" class="event-image"></image>
      </swiper-item>
    </swiper>
  </view>

  <!-- 赛事信息 -->
  <view class="info-section">
    <view class="event-title">{{eventDetail.title}}</view>

    <view class="info-item">
      <text class="info-icon">📍</text>
      <view class="info-content">
        <text class="info-label">举办地点</text>
        <text class="info-value">{{eventDetail.location}}</text>
      </view>
    </view>

    <view class="info-item">
      <text class="info-icon">🕒</text>
      <view class="info-content">
        <text class="info-label">举办时间</text>
        <text class="info-value">{{eventDetail.time}}</text>
      </view>
    </view>

    <view class="info-item description">
      <text class="info-icon">📋</text>
      <view class="info-content">
        <text class="info-label">赛事简介</text>
        <text class="info-value description-text">{{eventDetail.description}}</text>
      </view>
    </view>

    <view class="info-item">
      <text class="info-icon">👥</text>
      <view class="info-content">
        <text class="info-label">参赛人数</text>
        <text class="info-value">{{eventDetail.enrolled || 0}} / {{eventDetail.maxParticipants || 0}} 人</text>
      </view>
    </view>

    <view class="info-item">
      <text class="info-icon">👤</text>
      <view class="info-content">
        <text class="info-label">总负责人</text>
        <text class="info-value">{{eventDetail.manager}} · {{eventDetail.managerPhone}}</text>
      </view>
    </view>
  </view>

  <!-- 学生列表 -->
  <view class="students-section" wx:if="{{eventDetail.status !== '草稿中'}}">
    <view class="section-header">
      <text class="section-title">{{eventDetail.status === '已结束' ? '参赛学员' : '已报名学员'}}</text>
      <text class="section-count">{{studentList.length}}人</text>
    </view>

    <view class="student-list" wx:if="{{studentList.length > 0}}">
      <view class="student-card" wx:for="{{studentList}}" wx:key="id">
        <view class="student-avatar">
          <image src="{{item.avatar}}" mode="aspectFill"></image>
        </view>
        <view class="student-info">
          <text class="student-name">{{item.name}}</text>
          <text class="student-meta">{{item.grade}} · {{item.kindergarten}}</text>
        </view>
        <view class="student-status" wx:if="{{eventDetail.status === '已结束'}}">
          <text class="status-badge completed">已完赛</text>
        </view>
      </view>
    </view>

    <view class="empty-state" wx:else>
      <text class="empty-icon">👥</text>
      <text class="empty-text">暂无学员{{eventDetail.status === '已结束' ? '参赛' : '报名'}}</text>
    </view>
  </view>

  <!-- 编辑按钮 -->
  <view class="action-section" wx:if="{{eventDetail.status === '草稿中'}}">
    <button class="edit-btn" bindtap="onEditEvent">编辑赛事</button>
  </view>
</view>
