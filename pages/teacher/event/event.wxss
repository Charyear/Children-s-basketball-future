/* pages/teacher/event/event.wxss */
/* 返回大厅按钮 */
.back-home-btn {
  position: fixed;
  top: calc(40rpx + env(safe-area-inset-top));
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #FF7A2F 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
  z-index: 1000;
  transition: all 0.3s ease;
}

.back-home-btn:active {
  transform: scale(0.9);
}

.back-icon {
  font-size: 40rpx;
}

page {
  background: linear-gradient(to bottom, #FFF7ED 0%, #EFF6FF 100%);
}

.event-container {
  width: 100%;
  min-height: 100vh;
  padding-bottom: calc(100rpx + env(safe-area-inset-bottom));
}

/* 主内容区域 */
.main-content {
  padding: calc(40rpx + env(safe-area-inset-top)) 30rpx 20rpx;
}

/* 新建赛事按钮 */
.add-event-btn {
  margin-top: 30rpx;
  background-color: #FF7A2F;
  color: #FFFFFF;
  border-radius: 20rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 30rpx rgba(255, 122, 47, 0.2);
  line-height: 1;
}

.add-event-btn::after {
  border: none;
}

/* 状态筛选标签 */
.tab-bar {
  display: flex;
  gap: 20rpx;
  padding: 30rpx 0;
  overflow-x: auto;
  white-space: nowrap;
}

.tab-bar::-webkit-scrollbar {
  display: none;
}

.tab-item {
  display: inline-block;
  padding: 16rpx 32rpx;
  border-radius: 40rpx;
  font-size: 28rpx;
  font-weight: 500;
  white-space: nowrap;
  background-color: #FFFFFF;
  color: #666666;
  flex-shrink: 0;
}

.tab-item.active {
  background-color: #FF7A2F;
  color: #FFFFFF;
}

/* 赛事列表 */
.event-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-bottom: 40rpx;
}

.event-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.event-card-header {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.event-card-title-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.event-card-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
}

.event-card-status {
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-size: 22rpx;
  font-weight: 500;
}

.event-card-meta {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.event-card-meta-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 26rpx;
  color: #999999;
}

.event-card-footer {
  display: flex;
  gap: 20rpx;
  padding-top: 24rpx;
  margin-top: 24rpx;
  border-top: 1rpx solid #F5F5F5;
}

.event-card-btn {
  flex: 1;
  height: 64rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 500;
  padding: 0;
  line-height: 1;
}

.event-card-btn.primary {
  background-color: #EFF6FF;
  color: #3B82F6;
}

.event-card-btn.secondary {
  background-color: #FF7A2F;
  color: #FFFFFF;
}

.event-card-btn.warning {
  background-color: #FEF3C7;
  color: #F59E0B;
}

.event-card-btn.disabled {
  background-color: #F5F5F5;
  color: #999999;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 120rpx;
  color: #E5E7EB;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999999;
}
