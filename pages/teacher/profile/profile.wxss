/* pages/teacher/profile/profile.wxss */
/* 返回大厅按钮 */
.back-home-btn {
  position: fixed;
  top: calc(40rpx + env(safe-area-inset-top));
  left: 30rpx;
  width: 80rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #3B82F6 0%, #FF7A2F 100%);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 20rpx rgba(59, 130, 246, 0.3);
  z-index: 1000;
  transition: all 0.3s ease;
}

.back-home-btn:active {
  transform: scale(0.9);
}

.back-icon {
  font-size: 40rpx;
}

page {
  background: linear-gradient(to bottom, #EFF6FF 0%, #FFF7ED 100%);
}

.profile-container {
  width: 100%;
  min-height: 100vh;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

/* 头部信息 */
.profile-header {
  position: relative;
  padding-top: 0;
  padding-bottom: 40rpx;
}

.profile-header-bg {
  height: 280rpx;
  background: linear-gradient(135deg, #FF7A2F 0%, #FF9D5C 100%);
  border-radius: 0 0 40rpx 40rpx;
  padding-top: env(safe-area-inset-top);
}

.profile-info {
  position: relative;
  margin: -120rpx 30rpx 0;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  box-shadow: 0 8rpx 40rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  overflow: hidden;
  flex-shrink: 0;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.profile-avatar image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.profile-details {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.profile-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
}

.profile-role {
  font-size: 26rpx;
  color: #666666;
}

.profile-edit-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #FFF7F0;
  color: #FF7A2F;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  flex-shrink: 0;
}

/* 数据统计概览 */
.stats-overview {
  display: flex;
  margin: 30rpx;
  gap: 16rpx;
}

.stat-card {
  flex: 1;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.stat-value {
  font-size: 44rpx;
  font-weight: bold;
  color: #FF7A2F;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 22rpx;
  color: #999999;
}

/* 图表区域 */
.chart-section {
  margin: 30rpx;
  background: #fff;
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 30rpx;
  display: block;
}

/* 年级分布图表 */
.grade-chart {
  width: 100%;
}

.grade-bar-container {
  width: 100%;
  margin-bottom: 30rpx;
}

.grade-bar {
  height: 44rpx;
  background: #F5F5F5;
  border-radius: 22rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.grade-bar:last-child {
  margin-bottom: 0;
}

.grade-bar-fill {
  height: 100%;
  border-radius: 22rpx;
  transition: width 0.6s ease;
}

.grade-legend {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.legend-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.legend-dot {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  flex-shrink: 0;
}

.legend-text {
  font-size: 26rpx;
  color: #666666;
  min-width: 70rpx;
}

.legend-value {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
}

/* 近期活动趋势图表 */
.activity-chart {
  width: 100%;
}

.chart-bars {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  height: 280rpx;
  margin-bottom: 20rpx;
  gap: 16rpx;
}

.chart-bar {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.bar-wrapper {
  width: 100%;
  height: 240rpx;
  display: flex;
  gap: 6rpx;
  align-items: flex-end;
}

.bar-fill {
  flex: 1;
  border-radius: 8rpx 8rpx 0 0;
  transition: height 0.6s ease;
  min-height: 10rpx;
}

.bar-fill.events {
  background: linear-gradient(to top, #FF7A2F, #FF9D5C);
}

.bar-fill.students {
  background: linear-gradient(to top, #3B82F6, #60A5FA);
}

.bar-label {
  font-size: 22rpx;
  color: #999999;
}

.chart-legend {
  display: flex;
  justify-content: center;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #F5F5F5;
}

/* 基本信息 */
.info-section {
  margin: 30rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.04);
}

.info-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
  font-weight: 500;
}
