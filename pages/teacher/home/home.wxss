/* pages/teacher/home/home.wxss */
.home-container {
  width: 100%;
  height: 100vh;
  position: relative;
  overflow: hidden;
  background: linear-gradient(135deg, #3B82F6 0%, #FF7A2F 100%);
}

.background {
  position: absolute;
  width: 100%;
  height: 100%;
  opacity: 0.1;
  background-image: radial-gradient(circle at 20% 50%, rgba(255, 255, 255, 0.2) 0%, transparent 50%),
                    radial-gradient(circle at 80% 80%, rgba(255, 255, 255, 0.2) 0%, transparent 50%);
}

.title-section {
  position: absolute;
  top: 120rpx;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 10;
}

.main-title {
  display: block;
  font-size: 56rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 16rpx;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.2);
}

.sub-title {
  display: block;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
  letter-spacing: 4rpx;
}

.cards-container {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 600rpx;
  height: 600rpx;
}

.nav-card {
  position: absolute;
  width: 280rpx;
  height: 280rpx;
  background: linear-gradient(135deg, #FFFFFF 0%, #F8F9FA 100%);
  border-radius: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.3);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  opacity: 0;
  transform: translate(-50%, -50%) scale(0);
}

/* 卡片显示动画 */
.nav-card.show {
  opacity: 1;
  animation: cardZoomIn 0.6s cubic-bezier(0.34, 1.56, 0.64, 1) forwards;
}

/* 左上卡片 */
.card-top-left {
  top: 0;
  left: 0;
  transform-origin: center center;
}

.card-top-left.show {
  animation-delay: 0.1s;
}

/* 右上卡片 */
.card-top-right {
  top: 0;
  right: 0;
  transform-origin: center center;
}

.card-top-right.show {
  animation-delay: 0.2s;
}

/* 左下卡片 */
.card-bottom-left {
  bottom: 0;
  left: 0;
  transform-origin: center center;
}

.card-bottom-left.show {
  animation-delay: 0.3s;
}

/* 右下卡片 */
.card-bottom-right {
  bottom: 0;
  right: 0;
  transform-origin: center center;
}

.card-bottom-right.show {
  animation-delay: 0.4s;
}

/* 缩放动画 */
@keyframes cardZoomIn {
  0% {
    opacity: 0;
    transform: scale(0) translate(50%, 50%);
  }
  60% {
    opacity: 1;
  }
  100% {
    opacity: 1;
    transform: scale(1) translate(0, 0);
  }
}

/* 缩放返回动画 */
@keyframes cardZoomOut {
  0% {
    opacity: 1;
    transform: scale(1) translate(0, 0);
  }
  100% {
    opacity: 0;
    transform: scale(0) translate(-150%, -150%);
  }
}

.card-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 12rpx;
}

.card-desc {
  font-size: 24rpx;
  color: #999999;
}

/* 卡片hover效果 */
.nav-card:active {
  transform: scale(0.95);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.2);
}

/* 位置调整 */
.card-top-left.show {
  top: 0;
  left: 0;
}

.card-top-right.show {
  top: 0;
  left: 320rpx;
}

.card-bottom-left.show {
  top: 320rpx;
  left: 0;
}

.card-bottom-right.show {
  top: 320rpx;
  left: 320rpx;
}

/* 退出登录区域 */
.logout-section {
  position: absolute;
  bottom: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 400rpx;
  opacity: 0;
  transition: opacity 0.6s ease 0.5s;
}

.logout-section.show {
  opacity: 1;
}

.logout-btn {
  width: 100%;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 44rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  backdrop-filter: blur(10rpx);
  transition: all 0.3s ease;
}

.logout-btn::after {
  border: none;
}

.logout-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.98);
}
